<view class="page {{theme}}">
  <map
    id="route-map"
    class="map"
    latitude="{{center.latitude}}"
    longitude="{{center.longitude}}"
    scale="{{scale}}"
    markers="{{markers}}"
    polyline="{{polyline}}"
    enable-zoom
    enable-scroll
    enable-rotate="{{false}}"
    bindmarkertap="onMarkerTap"
    bindtap="onMapTap"
  ></map>

  <!-- 顶部：标题 + 上传入口（右侧给微信胶囊让位） -->
  <view class="top" style="padding-top: {{statusBarHeight}}px">
    <view class="top-row" style="padding-right: {{menuRight}}px">
      <view class="top-main">
        <view class="top-title">社区路线</view>
        <view class="top-sub">大家上传的路线，点赞高的排在前面</view>
      </view>
      <view class="upload-btn" bindtap="onUpload">＋ 上传</view>
    </view>

    <view class="city-tabs">
      <view
        wx:for="{{cityTabs}}"
        wx:key="id"
        class="city-tab {{activeCity === item.id ? 'active' : ''}}"
        data-id="{{item.id}}"
        bindtap="onCityTab"
      >{{item.name}}</view>
    </view>
  </view>

  <!-- 底部：社区路线列表（未选中路线时） -->
  <view class="panel" wx:if="{{!active}}">
    <view class="panel-head">
      <text class="panel-title">路线列表</text>
      <text class="panel-hint" wx:if="{{!loading && !error}}">{{routes.length}} 条</text>
    </view>

    <view class="state" wx:if="{{loading}}">加载中…</view>
    <view class="state error" wx:elif="{{error}}">{{error}}</view>

    <scroll-view class="list" scroll-y wx:else>
      <view
        wx:for="{{routes}}"
        wx:key="id"
        class="route"
        data-id="{{item.id}}"
        bindtap="onRouteTap"
      >
        <view class="route-main">
          <view class="route-title">{{item.title}}</view>
          <view class="route-meta">
            <text>{{item.nickname}}</text>
            <text>· {{item.count}} 站</text>
            <text wx:if="{{item.desc}}">· {{item.desc}}</text>
          </view>
        </view>
        <view class="like {{item.liked ? 'on' : ''}}" data-id="{{item.id}}" catchtap="onLike">
          <text class="like-ico">{{item.liked ? '♥' : '♡'}}</text>
          <text class="like-num">{{item.likes}}</text>
        </view>
      </view>

      <view class="empty" wx:if="{{!routes.length}}">
        还没有人上传路线
        <view class="empty-btn" bindtap="onUpload">上传我的行程，发第一条 ›</view>
      </view>
    </scroll-view>
  </view>

  <!-- 路线详情：站点 / 交通方式可切换，选完可一键加进行程 -->
  <view class="detail" wx:if="{{active}}">
    <view class="detail-grab"></view>

    <view class="detail-head">
      <view class="detail-main">
        <view class="detail-title">{{active.title}}</view>
        <view class="detail-meta">{{active.nickname}} · {{active.count}} 站 · {{active.distanceText}}</view>
      </view>
      <view class="detail-like {{active.liked ? 'on' : ''}}" data-id="{{active.id}}" catchtap="onLike">
        {{active.liked ? '♥' : '♡'}} {{active.likes}}
      </view>
      <view class="detail-close" catchtap="onCloseDetail">×</view>
    </view>

    <view class="tabs">
      <view class="tab {{tab === 'legs' ? 'on' : ''}}" data-tab="legs" catchtap="onTab">交通方式</view>
      <view class="tab {{tab === 'stops' ? 'on' : ''}}" data-tab="stops" catchtap="onTab">站点</view>
    </view>

    <scroll-view class="detail-body" scroll-y>
      <block wx:if="{{tab === 'legs'}}">
        <view class="totals">
          <view class="totals-item"><text class="dot walk"></text>全步行 {{totals.walk}} 分</view>
          <view class="totals-item"><text class="dot transit"></text>公交 {{totals.transit}} 分</view>
          <view class="totals-item"><text class="dot taxi"></text>打车 {{totals.taxi}} 分</view>
        </view>

        <view class="leg" wx:for="{{legs}}" wx:key="index">
          <view class="leg-head">
            <text class="leg-title">{{item.fromName}} → {{item.toName}}</text>
            <text class="leg-km">{{item.distanceText}}</text>
          </view>
          <view class="leg-modes">
            <view
              wx:for="{{item.modes}}"
              wx:for-item="m"
              wx:key="key"
              class="mode {{item.chosen === m.key ? 'on' : ''}} {{m.disabled ? 'off' : ''}}"
              data-leg="{{item.index}}"
              data-mode="{{m.key}}"
              catchtap="onModeTap"
              style="{{item.chosen === m.key && !m.disabled ? 'border-color:' + m.color + ';color:' + m.color : ''}}"
            >
              <text class="mode-name">{{m.name}}</text>
              <text class="mode-min">{{m.disabled ? '不推荐' : m.minutes + ' 分'}}</text>
            </view>
          </view>
        </view>
      </block>

      <block wx:else>
        <view class="stop" wx:for="{{active.stops}}" wx:key="id" data-index="{{index}}" catchtap="onStopTap">
          <text class="stop-num">{{index + 1}}</text>
          <text class="stop-emoji">{{item.emoji}}</text>
          <text class="stop-name">{{item.name}}</text>
          <text class="stop-go">›</text>
        </view>
      </block>
    </scroll-view>

    <view class="detail-foot">
      <view class="foot-ghost" catchtap="onCloseDetail">返回列表</view>
      <view class="foot-primary" catchtap="onUseRoute">一键加进行程 · 约 {{chosenTotal}} 分</view>
    </view>
  </view>

  <!-- 点位卡片 -->
  <view class="stop-card" wx:if="{{stopCard}}">
    <view class="stop-card-head">
      <view class="stop-card-title">{{stopCard.emoji}} {{stopCard.name}}</view>
      <view class="stop-card-close" catchtap="closeStopCard">×</view>
    </view>
    <view class="stop-card-meta">第 {{stopCard.index}} / {{stopCard.total}} 站</view>
    <view class="stop-card-btn" catchtap="onCardDetail">看详情 ›</view>
  </view>
</view>
