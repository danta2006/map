.page {
  min-height: 100vh;
  position: relative;
  background: var(--paper);
}

.map {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  width: 100%;
  height: 100%;
}

.top {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  z-index: 10;
  padding-bottom: 10rpx;
  background: rgba(251, 248, 242, 0.97);
  border-radius: 0 0 24rpx 24rpx;
}

.top-row {
  display: flex;
  align-items: center;
  padding: 12rpx 28rpx 0;
}

.top-main {
  flex: 1;
  min-width: 0;
}

.top-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--ink);
}

.top-sub {
  margin-top: 2rpx;
  font-size: 20rpx;
  color: var(--muted);
}

.upload-btn {
  flex-shrink: 0;
  margin-left: 12rpx;
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  background: var(--red);
  color: #fff;
  font-size: 22rpx;
}

.city-tabs {
  display: flex;
  gap: 12rpx;
  padding: 14rpx 28rpx 4rpx;
}

.city-tab {
  padding: 8rpx 22rpx;
  border-radius: 999rpx;
  background: #f2ece0;
  color: var(--ink2);
  font-size: 22rpx;
}

.city-tab.active {
  background: var(--red);
  color: #fff;
}

.panel {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 38vh;
  background: var(--paper);
  border-radius: 28rpx 28rpx 0 0;
  box-shadow: 0 -8rpx 30rpx rgba(60, 45, 20, 0.12);
  padding: 18rpx 24rpx 8rpx;
  z-index: 9;
  display: flex;
  flex-direction: column;
}

.panel-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 0 4rpx 10rpx;
}

.panel-title {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--ink);
}

.panel-hint {
  font-size: 20rpx;
  color: var(--muted);
}

.state {
  padding: 30rpx 10rpx;
  font-size: 24rpx;
  color: var(--muted);
}

.state.error {
  color: var(--red);
}

.list {
  flex: 1;
  min-height: 0;
}

.route {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx;
  margin-bottom: 12rpx;
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: 18rpx;
}

.route.active {
  border-color: var(--red);
  background: #fff7f2;
}

.route-main {
  flex: 1;
  min-width: 0;
}

.route-title {
  font-size: 27rpx;
  font-weight: 600;
  color: var(--ink);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.route-meta {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: var(--muted);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.route-meta text {
  margin-right: 6rpx;
}

.like {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: #f2ece0;
  color: var(--muted);
  font-size: 22rpx;
}

.like.on {
  background: #fbe9e7;
  color: #c0392b;
}

.like-ico {
  font-size: 26rpx;
}

.empty {
  padding: 34rpx 10rpx;
  font-size: 24rpx;
  color: var(--muted);
  line-height: 1.8;
}

.empty-btn {
  margin-top: 8rpx;
  color: var(--red);
  font-size: 25rpx;
}

.active-bar {
  position: absolute;
  left: 20rpx;
  right: 20rpx;
  bottom: calc(38vh + 18rpx);
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 14rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(29, 28, 25, 0.86);
  color: #fff;
  z-index: 9;
}

.active-title {
  font-size: 24rpx;
  font-weight: 600;
  max-width: 40%;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.active-meta {
  flex: 1;
  font-size: 20rpx;
  opacity: 0.82;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.active-like {
  flex-shrink: 0;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.16);
  font-size: 22rpx;
}

.active-like.on {
  background: #fff;
  color: var(--red);
}

.stop-card {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(38vh + 90rpx);
  z-index: 20;
  background: var(--card);
  border-radius: 20rpx;
  padding: 18rpx 22rpx;
  box-shadow: 0 12rpx 40rpx rgba(29, 28, 25, 0.24);
}

.stop-card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.stop-card-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--ink);
}

.stop-card-close {
  width: 44rpx;
  height: 44rpx;
  line-height: 40rpx;
  text-align: center;
  color: var(--muted);
  font-size: 34rpx;
}

.stop-card-meta {
  margin-top: 4rpx;
  font-size: 21rpx;
  color: var(--muted);
}

.stop-card-btn {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--red);
}
