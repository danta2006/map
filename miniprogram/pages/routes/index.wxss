.page {
  min-height: 100vh;
  position: relative;
  background: var(--paper);
}

.map {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  width: 100%;
  height: 100%;
}

.top {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  z-index: 10;
  padding-bottom: 10rpx;
  background: rgba(251, 248, 242, 0.97);
  border-radius: 0 0 24rpx 24rpx;
}

.top-row {
  display: flex;
  align-items: center;
  padding: 12rpx 28rpx 0;
}

.top-main {
  flex: 1;
  min-width: 0;
}

.top-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--ink);
}

.top-sub {
  margin-top: 2rpx;
  font-size: 20rpx;
  color: var(--muted);
}

.upload-btn {
  flex-shrink: 0;
  margin-left: 12rpx;
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  background: var(--red);
  color: #fff;
  font-size: 22rpx;
}

.city-tabs {
  display: flex;
  gap: 12rpx;
  padding: 14rpx 28rpx 4rpx;
}

.city-tab {
  padding: 8rpx 22rpx;
  border-radius: 999rpx;
  background: #f2ece0;
  color: var(--ink2);
  font-size: 22rpx;
}

.city-tab.active {
  background: var(--red);
  color: #fff;
}

.panel {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 38vh;
  background: var(--paper);
  border-radius: 28rpx 28rpx 0 0;
  box-shadow: 0 -8rpx 30rpx rgba(60, 45, 20, 0.12);
  padding: 18rpx 24rpx 8rpx;
  z-index: 9;
  display: flex;
  flex-direction: column;
}

.panel-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 0 4rpx 10rpx;
}

.panel-title {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--ink);
}

.panel-hint {
  font-size: 20rpx;
  color: var(--muted);
}

.state {
  padding: 30rpx 10rpx;
  font-size: 24rpx;
  color: var(--muted);
}

.state.error {
  color: var(--red);
}

.list {
  flex: 1;
  min-height: 0;
}

.route {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx;
  margin-bottom: 12rpx;
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: 18rpx;
}

.route.active {
  border-color: var(--red);
  background: #fff7f2;
}

.route-main {
  flex: 1;
  min-width: 0;
}

.route-title {
  font-size: 27rpx;
  font-weight: 600;
  color: var(--ink);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.route-meta {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: var(--muted);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.route-meta text {
  margin-right: 6rpx;
}

.like {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: #f2ece0;
  color: var(--muted);
  font-size: 22rpx;
}

.like.on {
  background: #fbe9e7;
  color: #c0392b;
}

.like-ico {
  font-size: 26rpx;
}

.empty {
  padding: 34rpx 10rpx;
  font-size: 24rpx;
  color: var(--muted);
  line-height: 1.8;
}

.empty-btn {
  margin-top: 8rpx;
  color: var(--red);
  font-size: 25rpx;
}

.active-bar {
  position: absolute;
  left: 20rpx;
  right: 20rpx;
  bottom: calc(38vh + 18rpx);
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 14rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(29, 28, 25, 0.86);
  color: #fff;
  z-index: 9;
}

.active-title {
  font-size: 24rpx;
  font-weight: 600;
  max-width: 40%;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.active-meta {
  flex: 1;
  font-size: 20rpx;
  opacity: 0.82;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.active-like {
  flex-shrink: 0;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.16);
  font-size: 22rpx;
}

.active-like.on {
  background: #fff;
  color: var(--red);
}

.stop-card {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(38vh + 90rpx);
  z-index: 20;
  background: var(--card);
  border-radius: 20rpx;
  padding: 18rpx 22rpx;
  box-shadow: 0 12rpx 40rpx rgba(29, 28, 25, 0.24);
}

.stop-card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.stop-card-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--ink);
}

.stop-card-close {
  width: 44rpx;
  height: 44rpx;
  line-height: 40rpx;
  text-align: center;
  color: var(--muted);
  font-size: 34rpx;
}

.stop-card-meta {
  margin-top: 4rpx;
  font-size: 21rpx;
  color: var(--muted);
}

.stop-card-btn {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--red);
}

/* ---------- 路线详情：站点 / 交通方式 ---------- */
.detail {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 56vh;
  background: var(--paper);
  border-radius: 28rpx 28rpx 0 0;
  box-shadow: 0 -10rpx 34rpx rgba(60, 45, 20, 0.16);
  z-index: 12;
  display: flex;
  flex-direction: column;
  padding: 14rpx 24rpx 12rpx;
}

.detail-grab {
  width: 72rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: #e0d6c4;
  margin: 0 auto 10rpx;
}

.detail-head {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
}

.detail-main {
  flex: 1;
  min-width: 0;
}

.detail-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--ink);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.detail-meta {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: var(--muted);
}

.detail-like {
  flex-shrink: 0;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: #f2ece0;
  color: var(--muted);
  font-size: 22rpx;
}

.detail-like.on {
  background: #fbe9e7;
  color: #c0392b;
}

.detail-close {
  flex-shrink: 0;
  width: 52rpx;
  height: 52rpx;
  line-height: 46rpx;
  text-align: center;
  font-size: 36rpx;
  color: var(--muted);
}

.tabs {
  display: flex;
  gap: 10rpx;
  margin: 12rpx 0 8rpx;
}

.tab {
  padding: 8rpx 24rpx;
  border-radius: 999rpx;
  background: #f2ece0;
  color: var(--ink2);
  font-size: 23rpx;
}

.tab.on {
  background: var(--ink);
  color: #fff;
}

.detail-body {
  flex: 1;
  min-height: 0;
}

.totals {
  display: flex;
  gap: 10rpx;
  margin-bottom: 12rpx;
}

.totals-item {
  flex: 1;
  text-align: center;
  padding: 10rpx 6rpx;
  background: #fffdf8;
  border: 1rpx solid var(--line);
  border-radius: 12rpx;
  font-size: 20rpx;
  color: var(--ink2);
}

.dot {
  display: inline-block;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  margin-right: 6rpx;
}

.dot.walk {
  background: #2c6b63;
}

.dot.transit {
  background: #3a6ea5;
}

.dot.taxi {
  background: #8b6f47;
}

.leg {
  padding: 12rpx 0;
  border-bottom: 1rpx dashed var(--line);
}

.leg-head {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
}

.leg-title {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--ink);
}

.leg-km {
  font-size: 20rpx;
  color: var(--muted);
}

.leg-modes {
  display: flex;
  gap: 8rpx;
  margin-top: 8rpx;
}

.mode {
  flex: 1;
  text-align: center;
  padding: 8rpx 4rpx;
  border: 1rpx solid var(--line);
  border-radius: 12rpx;
  background: #fffdf8;
  color: var(--ink2);
}

.mode.on {
  background: #fff5f1;
  border-width: 2rpx;
}

.mode.off {
  opacity: 0.4;
}

.mode-name {
  display: block;
  font-size: 20rpx;
}

.mode-min {
  display: block;
  font-size: 22rpx;
  font-weight: 600;
  margin-top: 2rpx;
}

.stop {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 14rpx 6rpx;
  border-bottom: 1rpx dashed var(--line);
}

.stop-num {
  width: 36rpx;
  height: 36rpx;
  line-height: 36rpx;
  text-align: center;
  border-radius: 50%;
  background: var(--red);
  color: #fff;
  font-size: 20rpx;
}

.stop-emoji {
  font-size: 26rpx;
}

.stop-name {
  flex: 1;
  font-size: 25rpx;
  color: var(--ink);
}

.stop-go {
  color: var(--muted);
  font-size: 26rpx;
}

.detail-foot {
  display: flex;
  gap: 12rpx;
  padding-top: 12rpx;
}

.foot-ghost {
  flex: 0 0 32%;
  height: 76rpx;
  line-height: 76rpx;
  text-align: center;
  border-radius: 38rpx;
  background: #f2ece0;
  color: var(--ink2);
  font-size: 24rpx;
}

.foot-primary {
  flex: 1;
  height: 76rpx;
  line-height: 76rpx;
  text-align: center;
  border-radius: 38rpx;
  background: var(--red);
  color: #fff;
  font-size: 24rpx;
  font-weight: 600;
}

/* 详情打开时，点位卡片上移到详情面板上方 */
.stop-card {
  bottom: calc(56vh + 90rpx);
}

/* ---------- 夜间模式 ---------- */
.page.dark .top {
  background: rgba(20, 18, 14, 0.97);
}

.page.dark .city-tab,
.page.dark .like,
.page.dark .tab,
.page.dark .totals-item,
.page.dark .mode,
.page.dark .foot-ghost,
.page.dark .detail-like {
  background: #211d17;
  border-color: var(--line);
  color: var(--ink-2);
}

.page.dark .city-tab.on,
.page.dark .tab.on {
  background: var(--red);
  border-color: var(--red);
  color: #fff;
}

.page.dark .route.active {
  background: rgba(207, 97, 85, 0.18);
}

.page.dark .like.on,
.page.dark .detail-like.on {
  background: rgba(207, 97, 85, 0.22);
  color: var(--red);
}

.page.dark .active-like {
  background: rgba(255, 255, 255, 0.1);
}

.page.dark .mode.on {
  background: rgba(255, 255, 255, 0.06);
}