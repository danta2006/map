.page {
  position: relative;
  width: 100vw;
  height: 100vh;
  overflow: hidden;
  background: var(--paper);
}

.map {
  width: 100%;
  height: 100%;
}

/* ---------- 顶部 ---------- */
.top {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  z-index: 10;
  padding: 16rpx 24rpx 18rpx;
  background: rgba(251, 248, 242, 0.97);
  border-radius: 0 0 24rpx 24rpx;
  box-shadow: 0 6rpx 24rpx rgba(29, 28, 25, 0.08);
}

.city-row {
  display: flex;
  align-items: center;
}

.city-pill {
  display: flex;
  align-items: center;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: #f2ece0;
  border: 1rpx solid var(--line);
}

.city-pill.open {
  background: var(--red);
  border-color: var(--red);
}

.city-pill-name {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--ink);
  line-height: 1.2;
}

.city-pill.open .city-pill-name,
.city-pill.open .city-pill-caret {
  color: #fff;
}

.city-pill-caret {
  margin-left: 6rpx;
  font-size: 18rpx;
  color: var(--muted);
  line-height: 1;
}

.city-hint {
  margin-left: 12rpx;
  font-size: 21rpx;
  color: var(--muted);
}

.city-panel {
  position: absolute;
  top: 96%;
  left: 24rpx;
  width: 340rpx;
  padding: 6rpx 0;
  background: #fffdf8;
  border-radius: 16rpx;
  border: 1rpx solid var(--line);
  box-shadow: 0 12rpx 32rpx rgba(29, 28, 25, 0.16);
  z-index: 30;
}

.city-option {
  display: flex;
  align-items: center;
  padding: 16rpx 22rpx;
}

.city-option.active {
  background: #f7f1e5;
}

.city-option-name {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--ink);
}

.city-option-count {
  flex: 1;
  margin-left: 12rpx;
  font-size: 20rpx;
  color: var(--muted);
}

.city-option-check {
  font-size: 24rpx;
  color: var(--red);
}

.tabs {
  display: flex;
  margin-top: 14rpx;
}

.tab {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 14rpx 8rpx;
  margin-right: 10rpx;
  border-radius: 14rpx;
  background: #f2ece0;
  font-size: 23rpx;
  color: var(--ink-2);
}

.tab:last-child {
  margin-right: 0;
}

.tab.active {
  background: #fffdf8;
  border: 1rpx solid var(--line);
  font-weight: 600;
  color: var(--ink);
  box-shadow: 0 4rpx 12rpx rgba(29, 28, 25, 0.08);
}

.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  margin-right: 8rpx;
}

.meta {
  margin-top: 14rpx;
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.desc {
  flex: 1;
  font-size: 22rpx;
  color: var(--muted);
  line-height: 1.5;
}

.nums {
  margin-left: 16rpx;
  font-size: 22rpx;
  color: var(--red);
  font-weight: 600;
  white-space: nowrap;
}

/* ---------- 底部：站点 / 交通 ---------- */
.bottom {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 10;
  padding-bottom: calc(18rpx + env(safe-area-inset-bottom));
  background: linear-gradient(
    180deg,
    rgba(251, 248, 242, 0) 0%,
    rgba(251, 248, 242, 0.9) 22%,
    rgba(251, 248, 242, 0.98) 100%
  );
}

.seg {
  display: flex;
  justify-content: center;
  padding-top: 10rpx;
}

.seg-item {
  padding: 8rpx 30rpx;
  margin: 0 8rpx;
  border-radius: 999rpx;
  background: #fffdf8;
  border: 1rpx solid var(--line);
  font-size: 22rpx;
  color: var(--ink-2);
}

.seg-item.active {
  background: var(--red);
  border-color: var(--red);
  color: #fff;
  font-weight: 600;
}

.stops-row {
  display: inline-flex;
  padding: 20rpx 24rpx 0;
}

.stop {
  display: flex;
  align-items: center;
  width: 300rpx;
  margin-right: 16rpx;
  padding: 16rpx 18rpx;
  background: #fffdf8;
  border: 1rpx solid var(--line);
  border-radius: 18rpx;
  box-shadow: 0 4rpx 12rpx rgba(29, 28, 25, 0.06);
}

.stop-num {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  margin-right: 14rpx;
  color: #fff;
  font-size: 24rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.stop-info {
  flex: 1;
  min-width: 0;
}

.stop-name {
  font-size: 25rpx;
  font-weight: 600;
  color: var(--ink);
  line-height: 1.35;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.stop-meta {
  font-size: 20rpx;
  color: var(--muted);
  margin-top: 2rpx;
}

/* 交通列表 */
.legs {
  height: 330rpx;
  padding: 12rpx 24rpx 0;
  box-sizing: border-box;
  margin-top: 10rpx;
}

.leg {
  display: flex;
  align-items: flex-start;
  padding: 14rpx 18rpx;
  margin-bottom: 10rpx;
  background: #fffdf8;
  border: 1rpx solid var(--line);
  border-radius: 14rpx;
}

.leg-idx {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  color: #fff;
  font-size: 22rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 14rpx;
  flex-shrink: 0;
}

.leg-body {
  flex: 1;
}

.leg-title {
  font-size: 23rpx;
  font-weight: 600;
  color: var(--ink);
}

.leg-text {
  margin-top: 2rpx;
  font-size: 21rpx;
  color: var(--muted);
  line-height: 1.5;
}

.leg-text.walk {
  color: var(--teal);
}

.leg-text.transit {
  color: #3a6ea5;
}

.leg-text.taxi {
  color: #8b6f47;
}


/* ---------- 地点卡片（上一段 / 下一段） ---------- */
.stop-card {
  position: absolute;
  left: 48rpx;
  right: 48rpx;
  bottom: 372rpx;
  z-index: 20;
  padding: 24rpx 28rpx;
  background: #fffdf8;
  border: 1rpx solid var(--line);
  border-radius: 20rpx;
  box-shadow: 0 16rpx 40rpx rgba(29, 28, 25, 0.18);
  opacity: 0;
  transform: translateY(16rpx);
  pointer-events: none;
  transition: opacity 0.2s ease, transform 0.2s ease;
}

.stop-card.show {
  opacity: 1;
  transform: translateY(0);
  pointer-events: auto;
}

.stop-card-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.stop-card-idx {
  font-size: 20rpx;
  letter-spacing: 1rpx;
  color: var(--muted);
}

.stop-card-close {
  font-size: 34rpx;
  line-height: 1;
  color: var(--muted);
  padding: 0 6rpx;
}

.stop-card-name {
  margin-top: 6rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: var(--ink);
}

.stop-card-leg {
  margin-top: 14rpx;
  padding: 12rpx 16rpx;
  background: #f7f2e8;
  border-radius: 12rpx;
}

.stop-card-leg-head {
  display: flex;
  align-items: center;
}

.stop-card-label {
  font-size: 20rpx;
  color: var(--muted);
  margin-right: 10rpx;
}

.stop-card-mode {
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  background: var(--teal);
  color: #fff;
  font-size: 18rpx;
}

.stop-card-mode.mode-transit {
  background: #3a6ea5;
}

.stop-card-mode.mode-taxi {
  background: #8b6f47;
}

.stop-card-text {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--ink-2);
  line-height: 1.55;
}

.stop-card-btn {
  margin-top: 18rpx;
  padding: 14rpx 0;
  text-align: center;
  border-radius: 999rpx;
  background: var(--red);
  color: #fff;
  font-size: 24rpx;
  font-weight: 600;
}


/* ---------- 路线段卡片（点路线弹出） ---------- */
.leg-card {
  position: absolute;
  left: 48rpx;
  right: 48rpx;
  bottom: 372rpx;
  z-index: 21;
  padding: 24rpx 28rpx;
  background: #fffdf8;
  border: 1rpx solid var(--line);
  border-radius: 20rpx;
  box-shadow: 0 16rpx 40rpx rgba(29, 28, 25, 0.18);
  opacity: 0;
  transform: translateY(16rpx);
  pointer-events: none;
  transition: opacity 0.2s ease, transform 0.2s ease;
}

.leg-card.show {
  opacity: 1;
  transform: translateY(0);
  pointer-events: auto;
}

.leg-card-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.leg-card-title {
  margin-top: 12rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--ink);
}

.leg-card-text {
  margin-top: 8rpx;
  font-size: 25rpx;
  color: var(--ink-2);
  line-height: 1.6;
}

.leg-card-tip {
  margin-top: 10rpx;
  text-align: center;
  font-size: 19rpx;
  color: #a49c8c;
}

/* 底部切到"交通"面板更高时，卡片往上抬，避免压住列表 */
.stop-card.high,
.leg-card.high {
  bottom: 520rpx;
}
