<view class="page {{theme}}">
  <map
    id="map"
    class="map"
    latitude="{{center.latitude}}"
    longitude="{{center.longitude}}"
    scale="{{scale}}"
    markers="{{markers}}"
    enable-zoom
    enable-scroll
    enable-rotate="{{false}}"
    bindmarkertap="onMarkerTap"
    bindcallouttap="onCalloutTap"
    bindregionchange="onViewChange"
    bindtap="onMapTap"
  >
    <!-- 图片气泡：放大到不重叠时，在点下方显示实景图 -->
    <cover-view slot="callout">
      <cover-view
        wx:for="{{bubbles}}"
        wx:key="id"
        marker-id="{{item.mid}}"
        data-mid="{{item.mid}}"
        class="poi-bubble"
        bindtap="onBubbleTap"
      >
        <cover-image class="bubble-img" src="/assets/{{item.photo}}" data-mid="{{item.mid}}" bindtap="onBubbleTap"></cover-image>
      </cover-view>
    </cover-view>
  </map>

  <!-- 夜间：地图压暗一层（不影响点击） -->
  <view class="map-tint" wx:if="{{theme === 'dark'}}"></view>

  <!-- 天气形态：半透明覆盖在地图上，pointer-events:none 不影响任何操作 -->
  <view class="weather-layer {{weather.kind}}" wx:if="{{weather.kind && !weather.error}}">
    <block wx:if="{{weather.kind === 'rain' || weather.kind === 'thunder'}}">
      <view
        class="rain-drop"
        wx:for="{{drops}}"
        wx:key="index"
        style="left: {{item.left}}%; animation-delay: {{item.delay}}s; animation-duration: {{item.dur}}s; opacity: {{item.opacity}}"
      ></view>
    </block>

    <block wx:if="{{weather.kind === 'snow'}}">
      <view
        class="snow-flake"
        wx:for="{{drops}}"
        wx:key="index"
        style="left: {{item.left}}%; animation-delay: {{item.delay}}s; animation-duration: {{item.dur + 3}}s; opacity: {{item.opacity}}"
      ></view>
    </block>

    <block wx:if="{{weather.kind === 'clear' || weather.kind === 'partly'}}">
      <view class="sun-glow"></view>
      <view class="sun-core"></view>
      <view class="sun-ray r1"></view>
      <view class="sun-ray r2"></view>
    </block>

    <block wx:if="{{weather.kind === 'overcast' || weather.kind === 'partly' || weather.kind === 'fog'}}">
      <view class="cloud c1"></view>
      <view class="cloud c2"></view>
      <view class="cloud c3"></view>
    </block>

    <view class="weather-flash" wx:if="{{weather.kind === 'thunder'}}"></view>
  </view>

  <!-- 顶部：城市切换 + 标题 + 分类筛选 -->
  <view class="header" style="padding-top: {{statusBarHeight}}px">
    <!-- 右侧留出微信胶囊按钮的宽度，避免搜索按钮被胶囊（…⊙）压住 -->
    <view class="brand-row" style="padding-right: {{menuRight}}px">
      <view class="city-pill {{showCityPicker ? 'open' : ''}}" bindtap="toggleCityPicker">
        <text class="city-pill-name">{{cityName}}</text>
        <text class="city-pill-caret">▾</text>
      </view>
      <view class="brand">
        <text class="brand-name">标点地图</text>
        <text class="brand-sub">{{activeName}} · {{markerCount}} 个点</text>
      </view>
      <!-- 天气 + 夜间模式入口：点开看近三天 -->
      <view class="weather-chip {{weather.kind}}" bindtap="toggleWeather">
        <text class="weather-emoji">{{weather.loading ? '🌡' : weather.emoji}}</text>
        <text class="weather-temp">{{weather.loading ? '…' : weather.tempText}}</text>
        <text class="weather-moon" wx:if="{{theme === 'dark'}}">🌙</text>
      </view>
      <view class="search-btn" bindtap="openSearch">🔍</view>
    </view>

    <!-- 城市下拉 -->
    <view class="city-panel" wx:if="{{showCityPicker}}">
      <view
        wx:for="{{cities}}"
        wx:key="id"
        class="city-option {{item.id === activeCity ? 'active' : ''}}"
        data-id="{{item.id}}"
        bindtap="onCityTap"
      >
        <text class="city-option-name">{{item.name}}</text>
        <text class="city-option-count">{{item.count}} 个点</text>
        <text class="city-option-check" wx:if="{{item.id === activeCity}}">✓</text>
      </view>
      <view class="city-panel-tip">长沙、株洲的点位正在陆续补充</view>
    </view>

    <scroll-view class="chips" scroll-x enhanced show-scrollbar="{{false}}">
      <view class="chips-row">
        <view
          class="chip {{activeCategory === '' ? 'active' : ''}}"
          data-key=""
          bindtap="onCategoryTap"
        >全部</view>
        <view
          wx:for="{{categories}}"
          wx:key="key"
          class="chip {{activeCategory === item.key ? 'active' : ''}}"
          data-key="{{item.key}}"
          bindtap="onCategoryTap"
        >
          <view class="chip-dot" style="background: {{item.color}}"></view>
          <text>{{item.name}}</text>
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- 近三天天气 + 夜间模式（点顶部的天气小胶囊打开） -->
  <view class="weather-panel" wx:if="{{showWeather}}" style="top: {{weatherTop}}px">
    <view class="wp-head">
      <text class="wp-title">近三天天气{{weather.cityName ? ' · ' + weather.cityName : ''}}</text>
      <text class="wp-close" catchtap="closeWeather">×</text>
    </view>

    <view class="wp-body" wx:if="{{weather.days.length}}">
      <view class="wp-row {{item.title === '今天' ? 'today' : ''}}" wx:for="{{weather.days}}" wx:key="date">
        <view class="wp-day">
          <text class="wp-day-title">{{item.title}}</text>
          <text class="wp-day-date">{{item.dateText}}</text>
        </view>
        <view class="wp-wx">
          <text class="wp-emoji">{{item.emoji}}</text>
          <text class="wp-label">{{item.label}}</text>
        </view>
        <view class="wp-temp">{{item.tMin}}° ~ {{item.tMax}}°</view>
        <view class="wp-pop">降水 {{item.pop}}%</view>
      </view>
    </view>
    <view class="wp-empty" wx:else>{{weather.loading ? '正在获取天气…' : '天气暂时取不到，点「刷新」再试'}}</view>

    <view class="wp-foot">
      <text class="wp-foot-k">夜间模式</text>
      <view class="wp-mode {{themeMode === 'auto' ? 'on' : ''}}" data-mode="auto" bindtap="onThemeMode">自动</view>
      <view class="wp-mode {{themeMode === 'day' ? 'on' : ''}}" data-mode="day" bindtap="onThemeMode">白天</view>
      <view class="wp-mode {{themeMode === 'night' ? 'on' : ''}}" data-mode="night" bindtap="onThemeMode">夜间</view>
      <text class="wp-refresh" bindtap="onWeatherRefresh">{{weather.loading ? '更新中…' : '刷新'}}</text>
    </view>
    <view class="wp-tip">「自动」= 19:00–06:00 自动进入夜间；天气 2 小时更新一次</view>
  </view>

  <!-- 搜索浮层：可跨城市搜点位，点结果直接加进行程 -->
  <view class="search-layer" wx:if="{{showSearch}}">
    <view class="search-backdrop" bindtap="closeSearch"></view>
    <view class="search-card" style="top: {{statusBarHeight + 8}}px; right: {{menuRight}}px">
      <place-search
        id="mapSearch"
        placeholder="搜索景点、美食、酒店…"
        auto-focus="{{true}}"
        theme="{{theme}}"
        bind:change="onSearchChange"
        bind:focus="onSearchFocus"
      />
      <view class="search-foot">
        <text class="search-foot-text">{{dayLabel}}已选 {{tripCount}} 个点位</text>
        <view class="search-foot-btn {{tripCount ? 'on' : ''}}" bindtap="onGoTrip">查看行程 ›</view>
      </view>
    </view>
  </view>

  <!-- 城市还没点位时的占位 -->
  <view class="empty" wx:if="{{empty}}">
    <view class="empty-title">{{cityName}}的点位还在采集中</view>
    <view class="empty-sub">用地图平台接口批量拉取后，这里就会有内容</view>
    <view class="empty-btn" bindtap="onSwitchToXiangtan">先看湘潭</view>
  </view>

  <view class="locate" bindtap="onLocate">◎</view>

  <!-- 左下角入口：我的行程（可排序 / 看行程地图）+ 精选路线 -->
  <view class="fab-stack">
    <view class="trip-fab {{tripCount ? 'has' : ''}}" bindtap="onGoTrip">
      <text class="fab-icon">📋</text>
      <text>我的行程{{tripCount ? ' ' + tripCount : ''}}</text>
    </view>
    <view class="route-fab" bindtap="onGoRoutes">🧭 社区路线</view>
  </view>

  <!-- 底部点位列表：主要入口，比点地图上的小图钉好点 -->
  <scroll-view class="poi-strip" scroll-x enhanced show-scrollbar="{{false}}">
    <view class="strip-row">
      <view
        wx:for="{{places}}"
        wx:key="id"
        class="strip-card {{current && current.id === item.id ? 'active' : ''}}"
        data-index="{{index}}"
        bindtap="onStripTap"
      >
        <view class="strip-emoji">{{item.emoji}}</view>
        <view class="strip-info">
          <view class="strip-name">{{item.name}}</view>
          <view class="strip-meta">{{item.durationMin}} 分钟</view>
        </view>
        <!-- 加号：把点位加进「我的行程」，已加入就显示是第几站 -->
        <view
          class="strip-add {{item.inTrip ? 'on' : ''}}"
          data-id="{{item.id}}"
          catchtap="onToggleTrip"
        >{{item.inTrip ? item.tripNo : '＋'}}</view>
      </view>
    </view>
  </scroll-view>

  <!-- 底部详情面板：收起是一张卡片，往上滑展开看完整介绍（小红书那种） -->
  <view
    class="sheet {{current ? 'show' : ''}} {{dragging ? 'dragging' : ''}}"
    style="height: {{sheetH}}px; transform: translateY({{sheetY}}px)"
    bindtouchstart="onSheetTouchStart"
    bindtouchmove="onSheetTouchMove"
    bindtouchend="onSheetTouchEnd"
  >
    <view class="sheet-grab" bindtap="onSheetTap">
      <view class="grab-bar"></view>
    </view>

    <view class="sheet-head" bindtap="onSheetTap">
      <view class="sheet-emoji" style="background: {{current.color}}">{{current.emoji}}</view>
      <view class="sheet-heading">
        <view class="sheet-title">{{current.name}}</view>
        <view class="sheet-meta">{{current.categoryName}} · 建议 {{current.durationMin}} 分钟</view>
      </view>
      <view
        class="sheet-trip {{current.inTrip ? 'on' : ''}}"
        data-id="{{current.id}}"
        catchtap="onToggleTrip"
      >{{current.inTrip ? '✓ 第 ' + current.tripNo + ' 站' : '＋ 行程'}}</view>
      <view class="sheet-close" catchtap="onCloseCard">×</view>
    </view>

    <view class="sheet-hint" wx:if="{{!expanded}}">上滑看完整介绍 · 点标题也能展开</view>

    <scroll-view class="sheet-body" scroll-y="{{expanded}}">
      <view class="sheet-summary">{{current.summary}}</view>

      <view class="facts">
        <view class="fact">
          <text class="fact-k">地址</text>
          <text class="fact-v">{{current.address}}</text>
        </view>
        <view class="fact">
          <text class="fact-k">开放</text>
          <text class="fact-v">{{current.openTime}}</text>
        </view>
        <view class="fact">
          <text class="fact-k">距你</text>
          <text class="fact-v {{current.canCheckin ? 'ok' : ''}}">{{current.distanceText}}</text>
        </view>
      </view>

      <view class="hl">关于这里</view>
      <view class="para">{{current.intro}}</view>

      <block wx:if="{{current.note}}">
        <view class="hl">备注或补充</view>
        <view class="para">{{current.note}}</view>
      </block>

      <view class="checked-banner" wx:if="{{current.checkedAt}}">✅ 已打卡 · {{current.checkedAt}}</view>
      <view class="body-pad"></view>
    </scroll-view>

    <view class="sheet-foot" wx:if="{{expanded}}">
      <view class="btn ghost" catchtap="onNavigate">导航</view>
      <view class="btn primary" catchtap="onSheetCheckin">{{current.checkedAt ? '已打卡' : '到这里打卡'}}</view>
    </view>
  </view>
</view>
