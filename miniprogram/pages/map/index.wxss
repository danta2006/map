.page {
  position: relative;
  width: 100vw;
  height: 100vh;
  overflow: hidden;
  background: var(--paper);
}

.map {
  width: 100%;
  height: 100%;
}

/* ---------- 顶部面板 ---------- */
.header {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  z-index: 10;
  padding-bottom: 16rpx;
  background: rgba(251, 248, 242, 0.97);
  border-radius: 0 0 28rpx 28rpx;
  box-shadow: 0 6rpx 24rpx rgba(29, 28, 25, 0.08);
}

.brand-row {
  display: flex;
  align-items: center;
  padding: 10rpx 32rpx 0;
}

/* ---------- 城市切换 ---------- */
.city-pill {
  display: flex;
  align-items: center;
  padding: 8rpx 18rpx;
  margin-right: 16rpx;
  border-radius: 999rpx;
  background: #f2ece0;
  border: 1rpx solid var(--line);
}

.city-pill.open {
  background: var(--red);
  border-color: var(--red);
}

.city-pill-name {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--ink);
  line-height: 1.2;
}

.city-pill.open .city-pill-name {
  color: #fff;
}

.city-pill-caret {
  margin-left: 8rpx;
  font-size: 20rpx;
  color: var(--muted);
  line-height: 1;
}

.city-pill.open .city-pill-caret {
  color: #fff;
}

.city-panel {
  position: absolute;
  top: 100%;
  left: 32rpx;
  width: 320rpx;
  padding: 8rpx 0 4rpx;
  background: #fffdf8;
  border-radius: 16rpx;
  border: 1rpx solid var(--line);
  box-shadow: 0 12rpx 32rpx rgba(29, 28, 25, 0.16);
  z-index: 30;
}

.city-option {
  display: flex;
  align-items: center;
  padding: 16rpx 22rpx;
}

.city-option.active {
  background: #f7f1e5;
}

.city-option-name {
  font-size: 26rpx;
  color: var(--ink);
  font-weight: 600;
}

.city-option-count {
  flex: 1;
  margin-left: 12rpx;
  font-size: 20rpx;
  color: var(--muted);
}

.city-option-check {
  font-size: 24rpx;
  color: var(--red);
}

.city-panel-tip {
  padding: 10rpx 22rpx 12rpx;
  font-size: 19rpx;
  color: #a49c8c;
  border-top: 1rpx solid var(--line);
}

/* ---------- 搜索 ---------- */
.search-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  margin-left: 12rpx;
  border-radius: 50%;
  background: #f2ece0;
  border: 1rpx solid var(--line);
  font-size: 26rpx;
  line-height: 1;
  flex-shrink: 0;
}

.search-layer {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 40;
}

.search-backdrop {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(29, 28, 25, 0.34);
}

.search-card {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  padding: 18rpx 18rpx 14rpx;
  background: var(--card);
  border-radius: 24rpx;
  box-shadow: 0 18rpx 52rpx rgba(29, 28, 25, 0.24);
}

.search-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 14rpx;
  padding: 0 6rpx;
}

.search-foot-text {
  font-size: 21rpx;
  color: var(--muted);
}

.search-foot-btn {
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  border: 1rpx solid var(--line);
  background: #fff;
  color: var(--muted);
  font-size: 21rpx;
}

.search-foot-btn.on {
  background: var(--red);
  border-color: var(--red);
  color: #fff;
  font-weight: 600;
}

/* ---------- 空城市占位 ---------- */
.empty {
  position: absolute;
  left: 60rpx;
  right: 60rpx;
  top: 45%;
  z-index: 12;
  padding: 36rpx 28rpx;
  background: rgba(255, 253, 248, 0.97);
  border: 1rpx solid var(--line);
  border-radius: 20rpx;
  box-shadow: 0 12rpx 32rpx rgba(29, 28, 25, 0.12);
  text-align: center;
}

.empty-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ink);
}

.empty-sub {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--muted);
}

.empty-btn {
  display: inline-block;
  margin-top: 20rpx;
  padding: 10rpx 30rpx;
  border-radius: 999rpx;
  background: var(--red);
  color: #fff;
  font-size: 23rpx;
}

.brand {
  display: flex;
  flex: 1;
  flex-direction: column;
  min-width: 0;
}

.brand-name {
  font-size: 34rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  color: var(--ink);
  line-height: 1.3;
}

.brand-sub {
  margin-top: 2rpx;
  font-size: 21rpx;
  color: var(--muted);
  letter-spacing: 1rpx;
}

/* ---------- 分类筛选 ---------- */
.chips {
  margin-top: 16rpx;
  white-space: nowrap;
}

.chips-row {
  display: inline-flex;
  padding: 0 24rpx 4rpx;
}

.chip {
  margin-right: 12rpx;
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  background: #fffdf8;
  border: 1rpx solid var(--line);
  font-size: 22rpx;
  color: var(--ink-2);
  line-height: 1.5;
}

.chip.active {
  background: var(--red);
  border-color: var(--red);
  color: #fff;
  font-weight: 600;
}

/* ---------- 定位按钮 ---------- */
.locate {
  position: absolute;
  right: 32rpx;
  bottom: 500rpx;
  z-index: 10;
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #fffdf8;
  border: 1rpx solid var(--line);
  color: var(--red);
  font-size: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 20rpx rgba(29, 28, 25, 0.12);
}

/* ---------- 左下角入口：我的行程 + 精选路线 ---------- */
.fab-stack {
  position: absolute;
  left: 32rpx;
  bottom: 500rpx;
  z-index: 16;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.route-fab,
.trip-fab {
  display: flex;
  align-items: center;
  padding: 14rpx 26rpx;
  border-radius: 999rpx;
  background: #fffdf8;
  border: 1rpx solid var(--line);
  color: var(--red);
  font-size: 23rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 20rpx rgba(29, 28, 25, 0.12);
}

.trip-fab {
  margin-bottom: 14rpx;
  border-color: var(--red);
}

/* 已经挑了点位：按钮变实心红，顺带当角标 */
.trip-fab.has {
  background: var(--red);
  border-color: var(--red);
  color: #fff;
}

.fab-icon {
  margin-right: 8rpx;
}

/* ---------- 底部点位列表 ---------- */
.poi-strip {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 15;
  padding-bottom: calc(18rpx + env(safe-area-inset-bottom));
  background: linear-gradient(
    180deg,
    rgba(251, 248, 242, 0) 0%,
    rgba(251, 248, 242, 0.9) 26%,
    rgba(251, 248, 242, 0.98) 100%
  );
}

.strip-row {
  display: inline-flex;
  padding: 30rpx 24rpx 0;
}

.strip-card {
  position: relative;
  display: flex;
  align-items: center;
  width: 300rpx;
  margin-right: 16rpx;
  padding: 16rpx 56rpx 16rpx 18rpx;
  background: #fffdf8;
  border: 1rpx solid var(--line);
  border-radius: 18rpx;
  box-shadow: 0 4rpx 12rpx rgba(29, 28, 25, 0.06);
}

/* 加号：加入行程；已加入则显示第几站 */
.strip-add {
  position: absolute;
  top: 10rpx;
  right: 10rpx;
  width: 46rpx;
  height: 46rpx;
  border-radius: 50%;
  background: #f4ecdf;
  border: 1rpx solid var(--line);
  color: var(--red);
  font-size: 28rpx;
  font-weight: 600;
  line-height: 42rpx;
  text-align: center;
}

.strip-add.on {
  background: var(--red);
  border-color: var(--red);
  color: #fff;
  font-size: 22rpx;
}

.strip-card.active {
  border-color: var(--red);
  box-shadow: 0 6rpx 16rpx rgba(176, 57, 46, 0.18);
}

.strip-emoji {
  font-size: 38rpx;
  margin-right: 14rpx;
  line-height: 1;
}

.strip-info {
  flex: 1;
  min-width: 0;
}

.strip-name {
  font-size: 25rpx;
  font-weight: 600;
  color: var(--ink);
  line-height: 1.35;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.strip-meta {
  font-size: 20rpx;
  color: var(--muted);
  margin-top: 2rpx;
}

/* ---------- 底部卡片 ---------- */
/* ---------- 底部详情面板（可上滑展开） ---------- */
.sheet {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  display: flex;
  flex-direction: column;
  background: var(--card);
  border-radius: 32rpx 32rpx 0 0;
  box-shadow: 0 -12rpx 40rpx rgba(29, 28, 25, 0.16);
  transform: translateY(100%);
  transition: transform 0.28s cubic-bezier(0.25, 0.9, 0.3, 1);
  pointer-events: none;
  overflow: hidden;
}

.sheet.show {
  pointer-events: auto;
}

.sheet.dragging {
  transition: none;
}

.sheet-grab {
  padding: 14rpx 0 4rpx;
  display: flex;
  justify-content: center;
  flex-shrink: 0;
}

.grab-bar {
  width: 72rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background: #ddd5c4;
}

.sheet-head {
  display: flex;
  align-items: center;
  padding: 8rpx 32rpx 0;
  flex-shrink: 0;
}

.sheet-emoji {
  width: 88rpx;
  height: 88rpx;
  border-radius: 22rpx;
  margin-right: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  flex-shrink: 0;
}

.sheet-heading {
  flex: 1;
  min-width: 0;
}

.sheet-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--ink);
}

.sheet-meta {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--muted);
}

.sheet-trip {
  flex-shrink: 0;
  margin-right: 10rpx;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  border: 1rpx solid var(--red);
  color: var(--red);
  font-size: 22rpx;
  font-weight: 600;
  background: #fff;
}

.sheet-trip.on {
  background: var(--red);
  border-color: var(--red);
  color: #fff;
}

.sheet-close {
  width: 56rpx;
  height: 56rpx;
  line-height: 52rpx;
  text-align: center;
  font-size: 36rpx;
  color: var(--muted);
  flex-shrink: 0;
}

.sheet-hint {
  text-align: center;
  font-size: 20rpx;
  color: #a49c8c;
  letter-spacing: 1rpx;
  padding: 10rpx 0 0;
  flex-shrink: 0;
}

.sheet-body {
  flex: 1;
  min-height: 0;
  padding: 0 32rpx;
  box-sizing: border-box;
}

.sheet-summary {
  margin-top: 16rpx;
  font-size: 28rpx;
  color: var(--ink-2);
  line-height: 1.6;
}

.facts {
  margin-top: 12rpx;
}

.fact {
  display: flex;
  padding: 12rpx 0;
  border-bottom: 1rpx dashed var(--line);
}

.fact-k {
  width: 96rpx;
  font-size: 22rpx;
  color: var(--muted);
  flex-shrink: 0;
}

.fact-v {
  flex: 1;
  font-size: 24rpx;
  color: var(--ink-2);
  line-height: 1.5;
}

.fact-v.ok {
  color: var(--teal);
  font-weight: 600;
}

.hl {
  margin-top: 28rpx;
  font-size: 21rpx;
  color: var(--muted);
  letter-spacing: 3rpx;
}

.para {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: var(--ink-2);
  line-height: 1.75;
  white-space: pre-wrap;
}

.checked-banner {
  margin-top: 24rpx;
  padding: 18rpx 24rpx;
  background: #e9f4ee;
  border-radius: 16rpx;
  color: var(--teal);
  font-size: 24rpx;
}

.body-pad {
  height: 40rpx;
}

.sheet-foot {
  display: flex;
  padding: 18rpx 32rpx calc(18rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid var(--line);
  background: var(--card);
  flex-shrink: 0;
}

.sheet-foot .btn {
  flex: 1;
}

.sheet-foot .btn + .btn {
  margin-left: 16rpx;
}

/* ---------- 点位图片气泡（圆形，不要方框） ---------- */
.poi-bubble {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  overflow: hidden;
  box-shadow: 0 6rpx 16rpx rgba(29, 28, 25, 0.22);
}

.bubble-img {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

/* 分类色点（图例）：每个 chip 前的小圆点 */
.chip {
  display: inline-flex;
  align-items: center;
}

.chip-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  margin-right: 8rpx;
  flex-shrink: 0;
  box-shadow: 0 0 0 1rpx rgba(29, 28, 25, 0.06);
}

.chip.active .chip-dot {
  box-shadow: 0 0 0 2rpx rgba(255, 255, 255, 0.92);
}

/* ---------- 天气小胶囊（顶部） ---------- */
.weather-chip {
  display: flex;
  align-items: center;
  height: 64rpx;
  padding: 0 16rpx;
  margin-left: 12rpx;
  border-radius: 999rpx;
  background: #f2ece0;
  border: 1rpx solid var(--line);
  flex-shrink: 0;
}

.weather-emoji {
  font-size: 24rpx;
  line-height: 1;
}

.weather-temp {
  margin-left: 6rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: var(--ink-2);
  line-height: 1;
}

.weather-moon {
  margin-left: 4rpx;
  font-size: 18rpx;
  line-height: 1;
}

/* ---------- 天气形态层：半透明，绝不挡操作 ---------- */
.map-tint {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 2;
  pointer-events: none;
  background: rgba(8, 10, 20, 0.3);
}

.weather-layer {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 2;
  pointer-events: none;
  overflow: hidden;
}

/* 雨 / 雷阵雨：斜向下落的细线 */
.rain-drop {
  position: absolute;
  top: -12%;
  width: 2rpx;
  height: 90rpx;
  border-radius: 2rpx;
  background: linear-gradient(to bottom, rgba(150, 185, 235, 0), rgba(120, 160, 220, 0.85));
  animation-name: weather-fall;
  animation-timing-function: linear;
  animation-iteration-count: infinite;
}

.rain-drop:nth-child(3n) {
  height: 130rpx;
  width: 3rpx;
}

.weather-layer.thunder .rain-drop {
  background: linear-gradient(to bottom, rgba(190, 205, 240, 0), rgba(170, 190, 235, 0.9));
}

@keyframes weather-fall {
  0% {
    transform: translate3d(0, -10vh, 0) rotate(14deg);
  }
  100% {
    transform: translate3d(-6vw, 112vh, 0) rotate(14deg);
  }
}

/* 雪：慢慢飘落的圆点 */
.snow-flake {
  position: absolute;
  top: -6%;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.9);
  animation-name: snow-fall;
  animation-timing-function: linear;
  animation-iteration-count: infinite;
}

@keyframes snow-fall {
  0% {
    transform: translate3d(0, -6vh, 0);
  }
  50% {
    transform: translate3d(5vw, 52vh, 0);
  }
  100% {
    transform: translate3d(-2vw, 112vh, 0);
  }
}

/* 晴 / 多云：右上角一轮暖光 */
.sun-glow {
  position: absolute;
  top: 110rpx;
  right: -80rpx;
  width: 560rpx;
  height: 560rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255, 214, 140, 0.55) 0%, rgba(255, 205, 120, 0.22) 42%, rgba(255, 205, 120, 0) 70%);
  animation: sun-breathe 6s ease-in-out infinite;
}

.sun-core {
  position: absolute;
  top: 250rpx;
  right: 88rpx;
  width: 132rpx;
  height: 132rpx;
  border-radius: 50%;
  background: radial-gradient(circle, #fff3d2 0%, #ffd88a 60%, #ffc866 100%);
  box-shadow: 0 0 70rpx rgba(255, 208, 130, 0.75);
  animation: sun-breathe 6s ease-in-out infinite;
}

.sun-ray {
  position: absolute;
  right: 90rpx;
  width: 120rpx;
  height: 2rpx;
  background: linear-gradient(to left, rgba(255, 216, 138, 0.85), rgba(255, 216, 138, 0));
  transform-origin: right center;
}

.sun-ray.r1 {
  top: 180rpx;
  transform: rotate(38deg);
}

.sun-ray.r2 {
  top: 440rpx;
  transform: rotate(-38deg);
}

@keyframes sun-breathe {
  0%,
  100% {
    opacity: 0.75;
    transform: scale(1);
  }
  50% {
    opacity: 1;
    transform: scale(1.06);
  }
}

/* 阴 / 多云 / 雾：几团慢慢飘的云 */
.cloud {
  position: absolute;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.62);
  box-shadow: 0 20rpx 60rpx rgba(120, 130, 150, 0.16);
  animation: cloud-drift 22s ease-in-out infinite;
}

.cloud.c1 {
  top: 150rpx;
  left: -120rpx;
  width: 420rpx;
  height: 150rpx;
}

.cloud.c2 {
  top: 250rpx;
  right: -140rpx;
  width: 500rpx;
  height: 180rpx;
  opacity: 0.75;
  animation-duration: 28s;
}

.cloud.c3 {
  top: 60rpx;
  right: 160rpx;
  width: 260rpx;
  height: 110rpx;
  opacity: 0.55;
  animation-duration: 34s;
}

.weather-layer.fog .cloud {
  top: auto;
  bottom: 34%;
  height: 120rpx;
  width: 140%;
  left: -20%;
  border-radius: 0;
  background: linear-gradient(to bottom, rgba(255, 255, 255, 0), rgba(255, 255, 255, 0.5), rgba(255, 255, 255, 0));
  animation: none;
}

@keyframes cloud-drift {
  0%,
  100% {
    transform: translateX(0);
  }
  50% {
    transform: translateX(36rpx);
  }
}

/* 雷阵雨：偶发白光 */
.weather-flash {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: #ffffff;
  opacity: 0;
  animation: weather-flash 7s linear infinite;
}

@keyframes weather-flash {
  0%,
  91%,
  93%,
  95%,
  100% {
    opacity: 0;
  }
  92% {
    opacity: 0.32;
  }
  94% {
    opacity: 0.16;
  }
}

/* ---------- 近三天天气面板 ---------- */
.weather-panel {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  z-index: 30;
  padding: 22rpx 24rpx 18rpx;
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: 24rpx;
  box-shadow: 0 18rpx 52rpx rgba(29, 28, 25, 0.2);
}

.wp-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.wp-title {
  font-size: 25rpx;
  font-weight: 700;
  color: var(--ink);
}

.wp-close {
  padding: 0 6rpx;
  font-size: 34rpx;
  line-height: 1;
  color: var(--muted);
}

.wp-row {
  display: flex;
  align-items: center;
  padding: 14rpx 0;
  border-top: 1rpx solid var(--line);
}

.wp-row.today .wp-day-title {
  color: var(--red);
}

.wp-day {
  display: flex;
  flex-direction: column;
  width: 128rpx;
  flex-shrink: 0;
}

.wp-day-title {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--ink);
}

.wp-day-date {
  font-size: 19rpx;
  color: var(--muted);
}

.wp-wx {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.wp-emoji {
  font-size: 26rpx;
  margin-right: 8rpx;
}

.wp-label {
  font-size: 23rpx;
  color: var(--ink-2);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.wp-temp {
  width: 132rpx;
  font-size: 21rpx;
  text-align: right;
  color: var(--ink-2);
}

.wp-pop {
  width: 120rpx;
  font-size: 19rpx;
  text-align: right;
  color: var(--muted);
}

.wp-empty {
  padding: 22rpx 0;
  font-size: 22rpx;
  text-align: center;
  color: var(--muted);
}

.wp-foot {
  display: flex;
  align-items: center;
  margin-top: 10rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid var(--line);
}

.wp-foot-k {
  margin-right: 10rpx;
  font-size: 21rpx;
  color: var(--muted);
}

.wp-mode {
  margin-right: 10rpx;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  border: 1rpx solid var(--line);
  font-size: 21rpx;
  color: var(--ink-2);
}

.wp-mode.on {
  background: var(--red);
  border-color: var(--red);
  color: #fff;
}

.wp-refresh {
  margin-left: auto;
  font-size: 21rpx;
  font-weight: 600;
  color: var(--blue);
}

.wp-tip {
  margin-top: 10rpx;
  font-size: 19rpx;
  line-height: 1.5;
  color: var(--muted);
}

/* ---------- 夜间模式：地图页硬编码浅色面覆盖 ---------- */
.page.dark .header {
  background: rgba(28, 24, 19, 0.97);
  border-color: var(--line);
}

.page.dark .city-pill,
.page.dark .search-btn,
.page.dark .weather-chip,
.page.dark .chip,
.page.dark .locate,
.page.dark .trip-fab,
.page.dark .route-fab,
.page.dark .strip-card {
  background: #262119;
  border-color: var(--line);
  color: var(--ink);
}

.page.dark .city-pill-name,
.page.dark .chip {
  color: var(--ink-2);
}

.page.dark .chip.active {
  background: var(--red);
  border-color: var(--red);
  color: #fff;
}

.page.dark .city-panel {
  background: #211d17;
  border-color: var(--line);
}

.page.dark .city-option-name {
  color: var(--ink);
}

.page.dark .city-panel-tip {
  color: var(--muted);
}

.page.dark .locate,
.page.dark .trip-fab,
.page.dark .route-fab {
  color: var(--ink);
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.36);
}

.page.dark .trip-fab.has {
  background: var(--red);
  border-color: var(--red);
  color: #fff;
}

.page.dark .empty {
  background: rgba(28, 24, 19, 0.97);
  border-color: var(--line);
}

.page.dark .empty-title {
  color: var(--ink);
}

.page.dark .empty-btn {
  background: #262119;
  border-color: var(--line);
  color: var(--ink-2);
}

.page.dark .empty-btn.primary {
  background: var(--red);
  border-color: var(--red);
  color: #fff;
}

.page.dark .poi-strip {
  background: linear-gradient(to top, rgba(20, 18, 14, 0.98), rgba(20, 18, 14, 0));
}

.page.dark .strip-name {
  color: var(--ink);
}

.page.dark .strip-add {
  background: #262119;
  border-color: var(--red);
  color: var(--red);
}

.page.dark .strip-add.on {
  background: var(--red);
  color: #fff;
}

.page.dark .sheet-trip {
  background: #262119;
  color: var(--red);
}

.page.dark .sheet-trip.on {
  background: var(--red);
  color: #fff;
}

.page.dark .sheet-close {
  color: var(--muted);
}

.page.dark .search-card {
  background: #211d17;
}

.page.dark .search-backdrop {
  background: rgba(0, 0, 0, 0.55);
}

.page.dark .search-foot-btn {
  background: #262119;
  border-color: var(--line);
  color: var(--ink-2);
}

.page.dark .search-foot-btn.on {
  background: var(--red);
  border-color: var(--red);
  color: #fff;
}
