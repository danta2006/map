.page {
  min-height: 100vh;
  background: var(--paper);
}

.head {
  display: flex;
  align-items: flex-start;
  padding: 20rpx 28rpx 16rpx;
}

.back {
  width: 56rpx;
  height: 56rpx;
  line-height: 52rpx;
  text-align: center;
  font-size: 40rpx;
  color: var(--ink);
  background: #f2ece0;
  border-radius: 50%;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.head-main {
  flex: 1;
  min-width: 0;
}

.head-title {
  font-size: 38rpx;
  font-weight: 700;
  color: var(--ink);
}

.head-sub {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--muted);
}

.body {
  padding: 0 28rpx 60rpx;
}

.block {
  background: #fffdf8;
  border: 1rpx solid var(--line);
  border-radius: 20rpx;
  padding: 20rpx;
  margin-bottom: 24rpx;
}

.block-title {
  font-size: 24rpx;
  color: var(--muted);
  margin-bottom: 12rpx;
}

.count {
  color: var(--red);
  font-weight: 600;
}

.stop-list {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.stop {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 8rpx 0;
}

.stop-num {
  width: 34rpx;
  height: 34rpx;
  line-height: 34rpx;
  text-align: center;
  border-radius: 50%;
  background: var(--red);
  color: #fff;
  font-size: 20rpx;
}

.stop-emoji {
  font-size: 26rpx;
}

.stop-name {
  font-size: 26rpx;
  color: var(--ink);
  flex: 1;
}

.stop-city {
  font-size: 20rpx;
  color: var(--muted);
}

.empty {
  font-size: 24rpx;
  color: var(--muted);
  line-height: 1.7;
}

.empty-btn {
  margin-top: 12rpx;
  color: var(--red);
  font-size: 25rpx;
}

.field {
  margin-bottom: 22rpx;
}

.label {
  font-size: 22rpx;
  color: var(--muted);
  margin-bottom: 8rpx;
}

.input {
  width: 100%;
  box-sizing: border-box;
  /* 微信 input 不会用 padding 撑高，必须写死高度，否则文字被裁 */
  height: 88rpx;
  line-height: 88rpx;
  padding: 0 20rpx;
  background: #fffdf8;
  border: 1rpx solid var(--line);
  border-radius: 14rpx;
  font-size: 26rpx;
  color: var(--ink);
}

/* textarea 走多行规则 */
.input.area {
  height: 180rpx;
  line-height: 1.6;
  padding: 18rpx 20rpx;
}

.error {
  color: #b0392e;
  font-size: 23rpx;
  margin-bottom: 12rpx;
}

.submit {
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  background: var(--red);
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
}

.submit.disabled {
  opacity: 0.55;
}

.tip {
  margin-top: 18rpx;
  font-size: 20rpx;
  color: #a49c8c;
  line-height: 1.6;
}

.cities {
  color: var(--muted);
}

.cross-tip {
  margin-top: 10rpx;
  padding: 10rpx 14rpx;
  border-radius: 10rpx;
  background: #fbf1e4;
  color: #8a6a3a;
  font-size: 21rpx;
  line-height: 1.6;
}
