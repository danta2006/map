.page {
  min-height: 100vh;
  background: var(--paper);
}

.head {
  padding: 28rpx 32rpx 20rpx;
}

.head-title {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--ink);
}

.head-sub {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: var(--muted);
  line-height: 1.6;
}

.body {
  padding: 0 32rpx 60rpx;
}

.field {
  margin-bottom: 26rpx;
}

.label {
  font-size: 23rpx;
  color: var(--muted);
  margin-bottom: 10rpx;
}

.input {
  width: 100%;
  box-sizing: border-box;
  padding: 20rpx 22rpx;
  background: #fffdf8;
  border: 1rpx solid var(--line);
  border-radius: 16rpx;
  font-size: 26rpx;
  color: var(--ink);
}

.area {
  height: 260rpx;
  line-height: 1.6;
}

.counter {
  margin-top: 6rpx;
  text-align: right;
  font-size: 20rpx;
  color: var(--muted);
}

.submit {
  margin-top: 10rpx;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  background: var(--red);
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
}

.submit.disabled {
  opacity: 0.6;
}

.tip {
  margin-top: 20rpx;
  font-size: 20rpx;
  color: #a49c8c;
  line-height: 1.6;
}
