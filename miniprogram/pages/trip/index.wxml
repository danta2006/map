<view class="page">
  <!-- 行程地图：编号图钉 + 按交通方式上色的连线 -->
  <map
    id="trip-map"
    class="map"
    latitude="{{center.latitude}}"
    longitude="{{center.longitude}}"
    scale="{{scale}}"
    markers="{{markers}}"
    polyline="{{polyline}}"
    enable-zoom
    enable-scroll
    enable-rotate="{{false}}"
    bindmarkertap="onMarkerTap"
    bindcallouttap="onCalloutTap"
    bindpolylinetap="onPolylineTap"
    bindregionchange="onViewChange"
    bindtap="onMapTap"
  />

  <!-- 顶部：返回 + 标题 + 统计 + 隐藏/显示排序 -->
  <view class="top" style="padding-top: {{statusBarHeight}}px">
    <view class="top-row">
      <view class="back" bindtap="onBack">‹</view>
      <view class="top-main">
        <view class="top-title">我的行程</view>
        <view class="top-sub" wx:if="{{summary}}">{{summary.count}} 个点 · 全程约 {{summary.totalText}}</view>
        <view class="top-sub" wx:else>还没有选点位</view>
      </view>
      <view class="panel-toggle" wx:if="{{!empty}}" bindtap="togglePanel">
        {{panel === 'hidden' ? '显示排序' : '隐藏排序'}}
      </view>
    </view>

    <!-- 打卡进度：走完几个点一目了然 -->
    <view class="progress" wx:if="{{progress && progress.total}}">
      <view class="progress-bar">
        <view class="progress-fill" style="width: {{progress.percent}}%"></view>
      </view>
      <text class="progress-label">已打卡 {{progress.done}}/{{progress.total}}</text>
    </view>

    <view class="summary-row" wx:if="{{summary}}">
      <view class="sum-item">
        <text class="sum-k">点位</text>
        <text class="sum-v">{{summary.count}} 个</text>
      </view>
      <view class="sum-item">
        <text class="sum-k">游玩</text>
        <text class="sum-v">{{summary.visitText}}</text>
      </view>
      <view class="sum-item">
        <text class="sum-k">在途</text>
        <text class="sum-v">{{summary.travelText}}</text>
      </view>
      <view class="sum-item">
        <text class="sum-k">里程</text>
        <text class="sum-v">{{summary.distanceText}}</text>
      </view>
    </view>
  </view>

  <!-- 空行程：直接引导回地图挑点位 -->
  <view class="empty" wx:if="{{empty}}">
    <view class="empty-emoji">🧺</view>
    <view class="empty-title">行程还是空的</view>
    <view class="empty-sub">搜索景点、美食、酒店，点开介绍卡片就能加入</view>
    <view class="empty-btn" bindtap="onSearchEmpty">🔍 搜索点位</view>
    <view class="empty-btn ghost" bindtap="onGoMap">去地图挑点位</view>
  </view>


  <!-- 点路线弹出的分段卡片：三种交通方式直接切换 -->
  <view class="seg-card" wx:if="{{legCard}}" style="bottom: {{cardBottom}}px">
    <view class="seg-card-top">
      <text class="seg-card-title">{{legCard.fromName}} → {{legCard.toName}}</text>
      <text class="seg-card-close" catchtap="closeLegCard">×</text>
    </view>
    <view class="seg-card-sub">{{legCard.distanceText}}{{legCard.estimated ? ' · 距离估算' : ' · 实测'}}</view>
    <view class="seg-modes">
      <view
        class="seg-mode {{m.active ? 'active' : ''}}"
        wx:for="{{legCard.modes}}"
        wx:for-item="m"
        wx:key="key"
        data-mode="{{m.key}}"
        catchtap="onCardModeTap"
      >
        <text class="seg-mode-name">{{m.name}}</text>
        <text class="seg-mode-time">约 {{m.minutes}} 分钟</text>
      </view>
    </view>
  </view>

  <!-- 面板隐藏时露一条底栏，随时可以再展开 -->
  <view class="hide-bar" wx:if="{{panel === 'hidden' && !empty}}" bindtap="togglePanel">
    <text class="hide-text">📋 {{summary.count}} 个点 · 在途 {{summary.travelText}}</text>
    <text class="hide-btn">显示排序列表</text>
  </view>

  <!-- 排序面板：拖动把手可在 半屏 / 全屏 / 隐藏 之间切换 -->
  <view
    class="panel {{draggingPanel ? 'dragging' : ''}}"
    style="height: {{panelH}}px; transform: translateY({{panelY}}px)"
  >
    <view
      class="grab"
      bindtouchstart="onGrabStart"
      bindtouchmove="onGrabMove"
      bindtouchend="onGrabEnd"
      bindtap="onPanelTap"
    >
      <view class="grab-bar"></view>
    </view>

    <view class="panel-head">
      <view class="panel-title">行程排序</view>
      <view class="panel-actions">
        <view class="panel-action" bindtap="onGoMap">＋ 加点</view>
        <view class="panel-action danger" wx:if="{{!empty}}" bindtap="onClear">清空</view>
      </view>
    </view>
    <view class="search-wrap">
      <place-search
        id="placeSearch"
        placeholder="搜索景点、美食、酒店…"
        bind:change="onSearchChange"
        bind:focus="onSearchFocus"
      />
    </view>

    <view class="panel-hint">上面可搜索景点 / 美食 / 酒店，点开介绍卡片再加；按住 ⠿ 拖动排序，也可以点 ▲ ▼；每段都能切换交通方式</view>

    <view class="drag-hint" wx:if="{{draggingId}}">{{dragHint}}</view>

    <scroll-view
      class="panel-body"
      scroll-y
      enhanced
      show-scrollbar="{{false}}"
      scroll-into-view="{{scrollTo}}"
      scroll-with-animation
    >
      <block wx:for="{{blocks}}" wx:key="key">
        <view
          class="stop-block {{draggingId === item.stop.id ? 'dragging' : ''}}"
          style="transform: translateY({{item.offset}}px)"
          data-block="{{item.index}}"
          bindtouchstart="onBlockTouchStart"
          bindtouchmove="onBlockTouchMove"
          bindtouchend="onBlockTouchEnd"
          bindtouchcancel="onBlockTouchEnd"
        >
          <!-- 一个站点 -->
          <view
            id="{{item.rowId}}"
            class="stop-row {{activeId === item.stop.id ? 'active' : ''}}"
          >
            <view class="drag-handle">⠿</view>
            <view class="stop-num" style="background: {{item.stop.color}}">{{item.index + 1}}</view>
            <view class="stop-main" data-stop="{{item.index}}" bindtap="onStopTap">
              <view class="stop-name">{{item.stop.emoji}} {{item.stop.name}}<text class="stop-done" wx:if="{{item.stop.checked}}">✓ 已打卡</text></view>
              <view class="stop-meta">{{item.stop.cityName}} · {{item.stop.categoryName}} · 建议 {{item.stop.durationMin}} 分钟</view>
            </view>
            <view class="stop-ops">
              <view class="op" data-stop="{{item.index}}" data-dir="-1" catchtap="onMoveStop">▲</view>
              <view class="op" data-stop="{{item.index}}" data-dir="1" catchtap="onMoveStop">▼</view>
              <view class="op danger" data-id="{{item.stop.id}}" catchtap="onRemoveStop">✕</view>
            </view>
          </view>

          <!-- 两站之间：三种交通方式的耗时 -->
          <view wx:if="{{item.leg}}" class="leg-row">
            <view class="leg-rail">
              <view class="leg-rail-line" style="background: {{item.leg.modeColor}}"></view>
              <view class="leg-rail-dot" style="background: {{item.leg.modeColor}}"></view>
            </view>
            <view class="leg-card">
              <view class="leg-top">
                <text class="leg-title">{{item.leg.fromName}} → {{item.leg.toName}}</text>
                <text class="leg-km">{{item.leg.distanceText}}</text>
              </view>
              <view class="leg-modes">
                <view
                  wx:for="{{item.leg.modes}}"
                  wx:for-item="m"
                  wx:key="key"
                  class="leg-mode {{item.leg.modeKey === m.key ? 'on' : ''}}"
                  style="{{item.leg.modeKey === m.key ? 'border-color: ' + m.color : ''}}"
                  data-from="{{item.leg.fromId}}"
                  data-to="{{item.leg.toId}}"
                  data-mode="{{m.key}}"
                  catchtap="onModeTap"
                >
                  <view class="leg-mode-dot" style="background: {{m.color}}"></view>
                  <view class="leg-mode-body">
                    <view class="leg-mode-name">
                      {{m.name}}
                      <text class="real-tag" wx:if="{{m.real}}">实测</text>
                    </view>
                    <view class="leg-mode-time">{{m.text}}</view>
                  </view>
                </view>
              </view>
              <view class="leg-tip" wx:if="{{item.leg.estimated}}">没有实测数据的点对按距离估算；带「实测」的时间来自高德路线规划</view>
              <view class="leg-tip warn" wx:if="{{item.leg.transitWeak}}">这段很近，坐公交不太划算</view>
            </view>
          </view>
        </view>
      </block>

      <view class="panel-pad"></view>
    </scroll-view>
  </view>
</view>