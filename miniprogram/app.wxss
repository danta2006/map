/* 全局样式与设计变量：所有页面只用这里的变量，不散落写颜色 */
page {
  --red: #b0392e;
  --teal: #2c6b63;
  --orange: #d98324;
  --blue: #3a6ea5;
  --brown: #8b6f47;
  --paper: #fbf8f2;
  --card: #fffdf8;
  --ink: #1d1c19;
  --ink-2: #3f3c35;
  --muted: #736d61;
  --line: #e5ddce;

  background: var(--paper);
  color: var(--ink);
  font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  line-height: 1.7;
}

view,
text,
scroll-view {
  box-sizing: border-box;
}

.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 84rpx;
  border-radius: 42rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.btn.primary {
  background: var(--red);
  color: #fff;
}

.btn.ghost {
  background: #fff;
  color: var(--ink);
  border: 1rpx solid var(--line);
}

/* ---------- 夜间模式 ----------
 * 页面根节点挂 .dark（<view class="page {{theme}}">），变量整体反转，
 * 所有用 var(--paper/--card/--ink/--line) 的地方会自动变深。
 */
.page.dark {
  --paper: #14120e;
  --card: #211d17;
  --ink: #f2ece0;
  --ink-2: #d8d0c2;
  --muted: #9c9384;
  --line: #37322a;
  --red: #cf6155;

  background: var(--paper);
  color: var(--ink);
}

.page.dark .btn.primary {
  background: var(--red);
  color: #fff;
}

.page.dark .btn.ghost {
  background: #262119;
  border-color: var(--line);
  color: var(--ink);
}
