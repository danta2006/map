# 复制为 admin/.env.local，填自己的值（这个文件已在 .gitignore，不会被提交）
# 小程序后台 → 开发管理 → 开发设置
WX_APPID=wx0000000000000000
WX_APPSECRET=your_app_secret_here
# 云开发环境 ID（云开发控制台 → 设置）
CLOUD_ENV=cloud1-xxxxxxxxxxxx
# 高德 Web 服务 Key（「重算交通/路径」用）
AMAP_KEY=your_amap_key_here
# 后台管理令牌（所有 /api/* 都要带 X-Admin-Token）。
# 留空也行：首次启动会自动生成随机值并追加写回本文件，浏览器打开后台页面即可用
ADMIN_TOKEN=
